{
    "name": "zfhassaan/jazzcash",
    "description": "JazzCash Payment Gateway Package for Laravel 8+",
    "type": "library",
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/support": "9.*"
    },
    "require-dev": {
        "orchestra/testbench": "7.*",
        "phpunit/phpunit": "^9.6|^10.5"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "zfhassaan\\jazzcash\\": "src/",
            "zfhassaan\\JazzCash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Hassaan Ali",
            "email": "zfhassaan@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "zfhassaan\\jazzcash\\provider\\ServiceProvider"
            ],
            "aliases": {
                "jazzcash": "zfhassaan\\JazzCash\\Facade\\JazzcashFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
